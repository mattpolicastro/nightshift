#!/bin/bash
# launchd entry point for `nightshift serve`, the build supervisor.
#
# launchd reads no shell config, so PATH is set here: openspec, codex, claude,
# cmake, gh and uv live under Homebrew. Agent sessions and verify steps get
# their own fixed PATH from the harness, not this one. Credentials are not
# sourced here: Codex profiles use their own login, and a manifest's env_file
# supplies anything else (CLAUDE_CODE_OAUTH_TOKEN, the Slack webhook).
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
cd "$HOME/Projects/nightshift"
exec /opt/homebrew/bin/uv run --no-sync nightshift serve
