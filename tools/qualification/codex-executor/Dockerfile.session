# Same integrity-checked official package as Dockerfile; see README build steps.
FROM alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
COPY package/vendor/aarch64-unknown-linux-musl/ /opt/codex/
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/tmp TMPDIR=/tmp
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["/bin/sleep"]
CMD ["2147483647"]
